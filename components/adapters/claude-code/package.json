{
  "name": "@lightrsi/claude-code-adapter",
  "version": "0.1.0-beta.1",
  "description": "TokenPilot adapter for Claude Code via an Anthropic-compatible gateway.",
  "lightrsi": {
    "role": "adapter"
  },
  "main": "dist/index.js",
  "bin": {
    "tokenpilot-claude-code": "dist/cli.js",
    "lightrsi-install-claude-code": "dist/install-claude-code.js",
    "lightmem2-install-claude-code": "dist/install-claude-code.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zjunlp/LightRSI.git",
    "directory": "components/adapters/claude-code"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@lightrsi/artifact-store": "workspace:*",
    "@lightrsi/cleaner": "workspace:*",
    "@lightrsi/tokenpilot": "workspace:*",
    "@lightrsi/eviction": "workspace:*",
    "@lightrsi/history": "workspace:*",
    "@lightrsi/host-adapter": "workspace:*",
    "@lightrsi/kernel": "workspace:*",
    "@lightrsi/mcp": "workspace:*",
    "@lightrsi/product-surface": "workspace:*",
    "@lightrsi/reduction": "workspace:*",
    "@lightrsi/stabilizer": "workspace:*"
  },
  "scripts": {
    "build": "tsx build.ts",
    "doctor:claude-code": "node --import tsx scripts/doctor-claude-code.ts",
    "install:claude-code": "node --import tsx scripts/install-claude-code.ts",
    "pack:release": "bash ./scripts/pack_release.sh",
    "pack:release:portable": "node ./scripts/pack-release.mjs",
    "report-cache-audit:claude-code": "node --import tsx scripts/report-cache-audit-claude-code.ts",
    "test": "node --import tsx --test tests/*.test.ts src/release-package.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "claude-code",
    "anthropic-messages",
    "tokenpilot",
    "context-management",
    "gateway"
  ]
}
